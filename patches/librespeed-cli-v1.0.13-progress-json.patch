@@ -195,0 +196,38 @@ func (s *Server) PingAndJitter(count int) (float64, float64, error) {
+const progressJSONInterval = 200 * time.Millisecond
+
+type progressJSONReport struct {
+	Type      string  `json:"type"`
+	Test      string  `json:"test"`
+	ElapsedMS int64   `json:"elapsed_ms"`
+	Bytes     uint64  `json:"bytes"`
+	Mbps      float64 `json:"mbps"`
+}
+
+func writeProgressJSON(test string, counter *BytesCounter) {
+	elapsed := time.Since(counter.start)
+	if elapsed <= 0 {
+		return
+	}
+	bytes := counter.Total()
+	report := progressJSONReport{
+		Type:      "progress",
+		Test:      test,
+		ElapsedMS: elapsed.Milliseconds(),
+		Bytes:     bytes,
+		Mbps:      float64(bytes) / elapsed.Seconds() / 125000,
+	}
+	data, err := json.Marshal(report)
+	if err != nil {
+		return
+	}
+	output.WriteError("%s\n", data)
+}
+
+func progressJSONTicker(enabled bool) (*time.Ticker, <-chan time.Time) {
+	if !enabled {
+		return nil, nil
+	}
+	ticker := time.NewTicker(progressJSONInterval)
+	return ticker, ticker.C
+}
+
